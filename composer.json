{
    "name": "devopsadmins/text-helpers",
    "description": "Serviço de manipulação de texto de alta performance para projetos em Laravel.",
    "license": "MIT",
    "authors": [
        {
            "name": "Everton Lima",
            "email": "eolimabr@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Arbe\\TextHelpers\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arbe\\TextHelpers\\Providers\\TextHelperServiceProvider"
            ]
        }
    }
}
